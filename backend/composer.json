{
    "name": "visiontir-backend",
    "description": "VisionTIR Backend - Vision and Thermal Infrared Analysis API",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jorge Soler"
        }
    ],
    "keywords": [
        "vision",
        "thermal",
        "infrared",
        "laravel",
        "api"
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
